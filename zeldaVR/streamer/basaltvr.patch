diff --git a/streamer/Sources/BasaltCore/AlvrPassthrough.swift b/streamer/Sources/BasaltCore/AlvrPassthrough.swift
new file mode 100644
index 0000000..c19c2fb
--- /dev/null
+++ b/streamer/Sources/BasaltCore/AlvrPassthrough.swift
@@ -0,0 +1,112 @@
+import Foundation
+
+// Local change for MacNativeGames VR (zeldaVR, 2026-11-27, vr.md row 4): the room around the game's screens through the ALVR
+// client's chroma key passthrough (our video has no alpha). The game asks over the runtime link (message 101, once this streamer
+// offered it with message 19 after the hello). The Quest gets it in the session settings of its next connection and, while it
+// streams, at once as ALVR's RealTimeConfig. ALVR 20.14.0: alvr/session/src/settings.rs VideoConfig.passthrough
+// (Switch<PassthroughMode>, flag real-time; PassthroughMode::RgbChromaKey(RgbChromaKeyConfig)), alvr/session/src/lib.rs
+// merge_from_json (the session form: a Switch is {enabled, content}, a Choice {variant, <variant>: content}), alvr/packets/src/lib.rs
+// RealTimeConfig (bincode 1, sent as ServerControlPacket::ReservedBuffer, as alvr/server_core/src/connection.rs does each second),
+// applied by the client in client_core/src/connection.rs and client_openxr/src/lib.rs ClientCoreEvent::RealTimeConfig.
+public struct AlvrPassthrough: Equatable, Sendable {
+    public var chromaKey: Bool
+    public var red: UInt8
+    public var green: UInt8
+    public var blue: UInt8
+    /// ALVR's distance_threshold, 1...255 (applied per channel, after the client's sRGB decode)
+    public var threshold: UInt8
+    /// ALVR's feathering, in %, 1...100
+    public var featherPercent: UInt8
+
+    /// ALVR's own default (session_settings_default): off; its chroma key values kept for when it is turned on there.
+    public static let off = AlvrPassthrough(chromaKey: false, red: 0, green: 255, blue: 0, threshold: 85, featherPercent: 5)
+
+    public init(chromaKey: Bool, red: UInt8, green: UInt8, blue: UInt8, threshold: UInt8, featherPercent: UInt8) {
+        self.chromaKey = chromaKey
+        self.red = red
+        self.green = green
+        self.blue = blue
+        self.threshold = threshold
+        self.featherPercent = featherPercent
+    }
+
+    /// Runtime link message 101: u8 mode (0 off, 1 RGB chroma key), u8 red, green, blue, u8 threshold (1...255),
+    /// u8 feathering in % (1...100), u16 0. nil: malformed.
+    public init?(linkPayload payload: Data) {
+        let b = [UInt8](payload)
+        guard b.count == 8, b[0] <= 1, b[6] == 0, b[7] == 0 else { return nil }
+        if b[0] == 0 {
+            self = .off
+            return
+        }
+        guard (1...255).contains(b[4]), (1...100).contains(b[5]) else { return nil }
+        self.init(chromaKey: true, red: b[1], green: b[2], blue: b[3], threshold: b[4], featherPercent: b[5])
+    }
+
+    /// session_settings.video.passthrough, in the session form ALVR's merge_from_json reads.
+    public var sessionValue: [String: Any] {
+        guard chromaKey else { return ["enabled": false] }
+        return [
+            "enabled": true,
+            "content": [
+                "variant": "RgbChromaKey",
+                "RgbChromaKey": [
+                    "red": Int(red), "green": Int(green), "blue": Int(blue),
+                    "distance_threshold": Int(threshold),
+                    "feathering": Double(featherPercent) / 100,
+                ],
+            ],
+        ]
+    }
+
+    /// The control packet (before the u32 big-endian length framing): bincode 1 of
+    /// ServerControlPacket::ReservedBuffer(bincode 1 of RealTimeConfig { passthrough, clientside_post_processing: None }).
+    /// clientside_post_processing stays None: this streamer never turns it on (ALVR's default is off).
+    public var realTimeConfigPayload: Data {
+        var config = Data()
+        if chromaKey {
+            config.append(1)                                    // Option::Some
+            Self.append(UInt32(1), to: &config)                 // PassthroughMode::RgbChromaKey (Blend 0, RgbChromaKey 1, HsvChromaKey 2)
+            config.append(contentsOf: [red, green, blue, threshold])
+            Self.append(Float(Double(featherPercent) / 100).bitPattern, to: &config)
+        } else {
+            config.append(0)                                    // Option::None: no passthrough
+        }
+        config.append(0)                                        // clientside_post_processing: None
+        var packet = Data()
+        Self.append(UInt32(6), to: &packet)                     // ServerControlPacket::ReservedBuffer
+        Self.append(UInt64(config.count), to: &packet)          // Vec<u8> length
+        packet.append(config)
+        return packet
+    }
+
+    private static func append<T: FixedWidthInteger>(_ value: T, to data: inout Data) {
+        var value = value.littleEndian
+        withUnsafeBytes(of: &value) { data.append(contentsOf: $0) }
+    }
+}
+
+/// What the game last asked for; the next ALVR connection's session settings carry it.
+public final class AlvrPassthroughState: @unchecked Sendable {
+    public static let shared = AlvrPassthroughState()
+    private let lock = NSLock()
+    private var value = AlvrPassthrough.off
+
+    public init() {}
+
+    public var current: AlvrPassthrough {
+        lock.lock()
+        defer { lock.unlock() }
+        return value
+    }
+
+    /// true when it changed.
+    @discardableResult
+    public func set(_ passthrough: AlvrPassthrough) -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        guard passthrough != value else { return false }
+        value = passthrough
+        return true
+    }
+}
