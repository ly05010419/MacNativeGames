+        // SURED: surface reduction without an old-value result. Descriptor,
+        // coordinates and integer operation use the existing surface ABI. Scope
+        // encoding follows Mesa NAK SM80 set_mem_order; PTX sured defines the
+        // reduction and byte/pixel addressing. No CPU read/modify/write is used.
+        public static void ASured(EmitterContext context)
+        {
+            AmpereOp x = new(context.CurrOp);
+            (int handle, int cbufSlot) = ATexHandle(context, x);
+            int size = x.Bits(73, 76), operation = x.Bits(87, 91), order = x.Bits(77, 81);
+            int dimension = x.Bits(61, 64);
+            if (cbufSlot != TextureOperation.DefaultCbufSlot || size > 1 || operation > 7 ||
+                dimension > 5 || (order != 0 && order != 5 && order != 7) ||
+                (operation == 3 || operation == 4))
+                throw AFail(context, "SURED 32-bit integer descriptor/reduction/scope form");
+            if (order == 5) context.GroupMemoryBarrier();
+            if (order == 7) context.MemoryBarrier();
+            EmitSured(context, (SuDim)dimension, Clamp.Ign, (RedOp)operation,
+                (SuatomSize)size, handle, x.Ra, x.Rb, 0, x.Bit(72), isBindless: false);
+            if (order == 5) context.GroupMemoryBarrier();
+            if (order == 7) context.MemoryBarrier();
         }
 
