+            int sr = x.Bits(72, 80);
+
+            for (int k = 0; k < (x.Bit(80) ? 2 : 1); k++)
+            {
+                if (x.Rd + k >= RegisterConsts.RegisterZeroIndex)
+                {
+                    break;
+                }
+
+                context.Copy(Register(x.Rd + k, RegisterType.Gpr), sr == 255 ? Const(0) : EmitSReg(context, (SReg)(sr + k)));
