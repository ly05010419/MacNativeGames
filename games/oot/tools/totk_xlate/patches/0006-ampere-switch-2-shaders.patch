+                    case 0x986:
+                    case 0x386:
+                    case 0x98e:
+                    case 0x9a8:
+                    case 0x3a8:
+                    case 0x9a9:
+                    case 0xb9b:
+                    case 0x99b:
+                    case 0x99d:
+                    case 0x9a0:
+                    case 0x9a2:
