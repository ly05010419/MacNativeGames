<!-- TOTK runtime shader translator: Switch Maxwell code -> SPIR-V via the vendored Ryujinx 1.3.2 shader translator. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RyuSrc Condition="'$(RyuSrc)' == ''">$(MSBuildThisFileDirectory)../../tooling/d2r-mobile/dm/third_party/ryujinx</RyuSrc>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Graphics.Shader/Ryujinx.Graphics.Shader.csproj" />
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Common/Ryujinx.Common.csproj" />
  </ItemGroup>
  <!-- SPIRV-Cross linked in (publish_native.sh builds the library; Service.cs SpirvCross calls it) -->
  <ItemGroup Condition="'$(TotkSpirvCrossLib)' != ''">
    <DirectPInvoke Include="totk_spirv_cross" />
    <NativeLibrary Include="$(TotkSpirvCrossLib)" />
    <LinkerArg Include="-lc++" />
  </ItemGroup>
</Project>
