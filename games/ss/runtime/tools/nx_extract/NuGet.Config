<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The builder passes the explicit local feed. Never inherit online feeds. -->
  <packageSources><clear /></packageSources>
  <fallbackPackageFolders><clear /></fallbackPackageFolders>
  <packageSourceMapping><clear /></packageSourceMapping>
  <config><add key="globalPackagesFolder" value="./obj/offline-packages" /></config>
</configuration>
