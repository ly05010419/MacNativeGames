@@ -34,6 +34,9 @@ int main(void) {
     h.has[PH_Z] = 0; h.has[PH_RX] = 1; h.axis[PH_RX] = -1; pad_hid_sticks(&h, s); CHECK(s[2] == -DM_STICK_MAX && s[3] == 0);   // Rx / Ry without Z
     h.has[PH_ACCEL] = 1; h.axis[PH_ACCEL] = -1; CHECK(!(pad_hid_buttons(&h) & DM_BTN_ZR));
     h.axis[PH_ACCEL] = pad_hid_norm(200, 0, 255); CHECK(pad_hid_buttons(&h) & DM_BTN_ZR);
+    CHECK(pad_hid_gc_verdict(0, 0) == PAD_HID_TAKE && pad_hid_gc_verdict(0, PAD_HID_TRIES) == PAD_HID_TAKE);   // the kernel's No: read here, whatever the class method says
+    CHECK(pad_hid_gc_verdict(1, 0) == PAD_HID_ASK_GC);
+    CHECK(pad_hid_gc_verdict(-1, 0) == PAD_HID_RETRY && pad_hid_gc_verdict(-1, PAD_HID_TRIES - 1) == PAD_HID_RETRY && pad_hid_gc_verdict(-1, PAD_HID_TRIES) == PAD_HID_ASK_GC);
     printf("t_pad_hid: %d checks, %d failed\n", checks, fails);
     return fails != 0;
 }
